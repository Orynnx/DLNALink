{
  "manifest_version": 2,
  "name": "DLNALink Stream Finder",
  "version": "0.1.0",
  "description": "Find direct media streams on the current tab and share them to DLNALink.",
  "permissions": ["webRequest", "webNavigation", "tabs", "<all_urls>"],
  "browser_specific_settings": {"gecko": {"id": "stream-finder@dlnalink.local"}, "gecko_android": {}},
  "background": {"scripts": ["media.js", "background.js"]},
  "browser_action": {"default_title": "Find streams", "default_popup": "popup.html"}
}
